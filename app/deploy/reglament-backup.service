[Unit]
Description=Verified Reglament SQLite backup
ConditionPathExists=/opt/stacks/reglament/data/regatta.sqlite

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/reglament-backup
User=root
Group=root
UMask=0077
TimeoutStartSec=15min
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
RestrictAddressFamilies=AF_UNIX
ReadWritePaths=/opt/stacks/reglament/data /var/backups/reglament /run/lock/pult-deployer
