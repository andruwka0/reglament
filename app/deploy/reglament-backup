#!/usr/bin/python3
import argparse
import fcntl
import os
import re
import sqlite3
import sys
import tempfile
import time
from contextlib import closing
from datetime import datetime, timezone
from pathlib import Path


SNAPSHOT_NAME = re.compile(r"daily-\d{8}T\d{12}Z\.sqlite")


def sync_directory(path):
    handle = os.open(path, os.O_RDONLY | os.O_DIRECTORY)
    try:
        os.fsync(handle)
    finally:
        os.close(handle)


def copy_database(source, staging):
    # Read-only SQLite can leave WAL sidecars if it is the only process with the file open.
    owner = source.stat()
    sidecars = [source.with_name(source.name + suffix) for suffix in ("-wal", "-shm")]
    absent = [path for path in sidecars if not path.exists()]
    try:
        with closing(sqlite3.connect(source.resolve().as_uri() + "?mode=ro", uri=True, timeout=10)) as live:
            live.execute("PRAGMA query_only = ON")
            with closing(sqlite3.connect(staging)) as copy:
                live.backup(copy, pages=128, sleep=0.1)
                if copy.execute("PRAGMA journal_mode = DELETE").fetchone() != ("delete",):
                    raise ValueError("Backup journal could not be closed")
    finally:
        if os.geteuid() == 0 and owner.st_uid != 0:
            for path in absent:
                try:
                    os.chown(path, owner.st_uid, owner.st_gid, follow_symlinks=False)
                except FileNotFoundError:
                    pass


def snapshot(source, destination):
    if source.is_symlink() or not source.is_file():
        raise ValueError("Database does not exist or is not a regular file")
    if destination.is_symlink():
        raise ValueError("Backup directory must not be a symlink")
    destination.mkdir(mode=0o700, parents=True, exist_ok=True)
    destination.chmod(0o700)

    with tempfile.TemporaryDirectory(prefix=".reglament-backup-", dir=destination) as tmp:
        staging = Path(tmp) / "snapshot.sqlite"
        copy_database(source, staging)
        # Reopen the standalone file the same way a restore would inspect it.
        with closing(sqlite3.connect(staging.as_uri() + "?mode=ro", uri=True)) as check:
            if check.execute("PRAGMA integrity_check").fetchall() != [("ok",)]:
                raise ValueError("Backup integrity check failed")
            if check.execute("PRAGMA foreign_key_check").fetchone() is not None:
                raise ValueError("Backup foreign key check failed")
            for table in ("events", "templates", "covers"):
                check.execute(f"SELECT count(*) FROM {table}").fetchone()
        with staging.open("rb") as handle:
            os.fsync(handle.fileno())
        name = datetime.now(timezone.utc).strftime("daily-%Y%m%dT%H%M%S%fZ.sqlite")
        final = destination / name
        staging.replace(final)
        sync_directory(destination)

    verified = sorted((path for path in destination.iterdir() if SNAPSHOT_NAME.fullmatch(path.name)
                       and path.is_file() and not path.is_symlink()), reverse=True)
    for old in verified[7:]:
        old.unlink()
    sync_directory(destination)
    return final


def main():
    parser = argparse.ArgumentParser(description="Verify and rotate Reglament SQLite snapshots.")
    parser.add_argument("--database", type=Path, default=Path("/opt/stacks/reglament/data/regatta.sqlite"))
    parser.add_argument("--destination", type=Path, default=Path("/var/backups/reglament"))
    parser.add_argument("--lock", type=Path, default=Path("/run/lock/pult-deployer/reglament.lock"))
    args = parser.parse_args()
    os.umask(0o077)

    with args.lock.open("a") as lock:
        os.fchmod(lock.fileno(), 0o600)
        deadline = time.monotonic() + 300
        while True:
            try:
                fcntl.flock(lock.fileno(), fcntl.LOCK_EX | fcntl.LOCK_NB)
                break
            except BlockingIOError:
                if time.monotonic() >= deadline:
                    raise TimeoutError("Another Reglament operation is still running")
                time.sleep(1)
        final = snapshot(args.database, args.destination)
    print(f"Verified SQLite snapshot: {final.name}")


if __name__ == "__main__":
    try:
        main()
    except (OSError, sqlite3.Error, ValueError) as error:
        print(f"Reglament backup failed: {error}", file=sys.stderr)
        sys.exit(1)
